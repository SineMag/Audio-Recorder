{
  "expo": {
    "name": "Audio-Recorder",
    "slug": "Audio-Recorder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/record icon.png",
    "scheme": "audiorecorder",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow microphone access to record audio."
      }
    },
    "android": {
      "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#341238",
        "foregroundImage": "./assets/images/record icon.png",
        "backgroundImage": "./assets/images/record icon.png",
        "monochromeImage": "./assets/images/record icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/record icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Audio Recorder to access your microphone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/record icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#341238",
          "dark": {
            "backgroundColor": "#341238"
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
